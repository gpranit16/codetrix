{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "apps/mobile/App.tsx",
    "apps/mobile/index.ts",
    "apps/mobile/src/**/*",
    "server/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist"
  ]
}
